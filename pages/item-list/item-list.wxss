/* item-list — 企业级商品列表 */
.list-page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== 筛选排序栏 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  background: var(--card);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--line-light);
  position: sticky;
  top: 0;
  z-index: 10;
}
.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  padding: 8rpx 0;
  transition: all 0.15s;
}
.filter-tab.active {
  color: var(--primary);
  font-weight: 700;
}
.sort-arrow {
  font-size: 20rpx;
}
.layout-icon {
  font-size: 32rpx;
}

/* ===== 商品容器 ===== */
.goods-container {
  padding: 16rpx;
}
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.list-1 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ===== 骨架屏 ===== */
.loading-skeleton {
  padding: 16rpx;
}
.loading-skeleton.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.loading-skeleton.list-1 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sk-card {
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  padding-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.sk-img {
  width: 100%;
  height: 300rpx;
  background: var(--bg-soft);
}
.sk-line {
  height: 24rpx;
  background: var(--bg-soft);
  margin: 14rpx 18rpx 0;
  border-radius: 6rpx;
}
.sk-line-short {
  width: 50%;
  height: 24rpx;
  background: var(--bg-soft);
  margin: 8rpx 18rpx 0;
  border-radius: 6rpx;
}
.skeleton-anim {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}
@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ===== 加载更多 ===== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 24rpx 0;
}
.loading-dot {
  font-size: 16rpx;
  color: var(--text-3);
  animation: dot-bounce 1.4s ease infinite;
}
.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-bounce {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}
.loading-text {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 8rpx;
}

/* ===== 到底提示 ===== */
.finished-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
}
.finished-line {
  width: 60rpx;
  height: 2rpx;
  background: var(--text-3);
}
.finished-text {
  font-size: 24rpx;
  color: var(--text-3);
}
