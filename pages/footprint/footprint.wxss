/* footprint — 企业级浏览记录（蓝色渐变风格） */
.fp-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 40rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  padding: 8rpx 0;
}
.nav-placeholder { width: 64rpx; }
.fp-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 40rpx 0 40rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  position: relative;
  z-index: 2;
}

/* ========== 浏览记录列表 ========== */
.fp-list {
  padding: 24rpx;
}
.fp-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 28rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  position: relative;
  overflow: hidden;
}
.fp-img-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-soft);
}
.fp-img { width: 100%; height: 100%; }
.fp-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-soft);
}
.fp-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.fp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}
.fp-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}
.fp-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}
.fp-view-count {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
  background: var(--bg-soft);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}
.fp-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.fp-remove {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 24rpx 0;
}

/* 空状态 */
.empty-wrap { padding: 100rpx 0; }
