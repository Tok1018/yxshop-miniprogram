/* feedback — 意见反馈页面 */
.fb-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 32rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* ========== Tab 切换 ========== */
.tab-bar {
  display: flex;
  background: var(--card);
  margin: -20rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  position: relative;
  z-index: 3;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
  border-radius: 14rpx;
  position: relative;
  transition: all 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-weight: 700;
}
.tab-dot {
  position: absolute;
  top: 12rpx;
  right: 50%;
  margin-right: -40rpx;
  width: 14rpx;
  height: 14rpx;
  background: #ef4444;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* ========== 提交反馈 ========== */
.submit-area {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.section-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
}
.card-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

/* 类型选择 */
.type-grid {
  display: flex;
  gap: 16rpx;
}
.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: var(--bg-soft);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.type-item.active {
  background: var(--primary-50);
  border-color: var(--primary);
}
.type-item text {
  font-size: 24rpx;
  color: var(--text-2);
}
.type-item.active text {
  color: var(--primary);
  font-weight: 600;
}

/* 内容输入 */
.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  padding: 0;
}
.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 图片上传 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}
.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
  border: 2rpx dashed var(--text-3);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 联系方式 */
.contact-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-1);
  padding: 0;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.submit-btn.disabled {
  opacity: 0.6;
}

/* ========== 历史记录 ========== */
.history-area {
  padding: 24rpx;
}
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.history-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
}
.hc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.hc-type {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.type-1 { background: rgba(37,99,235,0.1); color: var(--primary); }
.type-2 { background: rgba(220,38,38,0.1); color: var(--danger); }
.type-3 { background: rgba(245,158,11,0.1); color: var(--accent); }
.type-4 { background: rgba(100,116,139,0.1); color: var(--text-2); }

.hc-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.status-0 { background: rgba(245,158,11,0.1); color: var(--accent); }
.status-1 { background: rgba(16,185,129,0.1); color: var(--success); }
.status-2 { background: rgba(100,116,139,0.1); color: var(--text-2); }

.hc-content {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
}
.hc-images {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.hc-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 10rpx;
}
.hc-reply {
  margin-top: 16rpx;
  background: var(--primary-50);
  border-radius: 12rpx;
  padding: 16rpx;
}
.reply-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}
.reply-content {
  font-size: 26rpx;
  color: var(--primary);
  line-height: 1.5;
}
.hc-time {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 12rpx;
}

/* ========== 加载/空状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 20rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: var(--text-3); }
.empty-wrap { padding: 100rpx 0; }
