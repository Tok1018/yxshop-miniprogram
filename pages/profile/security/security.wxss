/* security — 账号安全页面（对齐系统蓝色风格） */
.sec-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 48rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* ========== 安全评分 ========== */
.score-area {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 32rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.score-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.score-ring-inner {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(37,99,235,0.8);
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}
.score-num {
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
}
.score-unit {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}
.score-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.score-level {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
.score-tip {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ========== 通用卡片 ========== */
.section-card {
  background: var(--card);
  margin: 24rpx 24rpx 0 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  overflow: hidden;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

/* ========== 安全项列表 ========== */
.sec-list {
  padding: 0 24rpx;
}
.sec-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 20rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.sec-item:last-child {
  border-bottom: none;
}
.si-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.si-icon-1 { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
.si-icon-2 { background: linear-gradient(135deg, #10b981, #34d399); }
.si-icon-3 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.si-icon-4 { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }

.si-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.si-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.si-desc {
  font-size: 24rpx;
  color: var(--text-3);
}
.si-desc-warn {
  color: var(--danger);
}
.si-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.si-action {
  font-size: 24rpx;
  font-weight: 600;
}
.si-action-bound {
  color: var(--text-3);
}
.si-action-unbound {
  color: var(--primary);
}

/* ========== 登录信息 ========== */
.info-list {
  padding: 0 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line-light);
}
.info-row:last-child {
  border-bottom: none;
}
.ir-label {
  font-size: 26rpx;
  color: var(--text-2);
}
.ir-value {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* ========== 危险操作 ========== */
.danger-section .card-header {
  color: var(--danger);
}
.danger-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  gap: 16rpx;
  border-top: 2rpx solid var(--line-light);
}
.di-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.di-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
}
.di-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ========== 弹层 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15,23,42,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.modal-panel {
  width: 100%;
  background: var(--card);
  border-radius: 64rpx 64rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.modal-title-danger {
  color: var(--danger);
}
.modal-close {
  font-size: 48rpx;
  color: #cbd5e1;
  padding: 0 8rpx;
  line-height: 1;
  font-weight: 300;
}

.modal-body {
  padding: 24rpx 32rpx;
}

/* 表单 */
.form-row {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 10rpx;
}
.required { color: var(--danger); }
.form-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-soft);
  border-radius: 12rpx;
  padding: 0 20rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  padding: 16rpx 0;
}
.pwd-toggle {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.form-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

/* 保存按钮 */
.modal-save {
  margin: 8rpx 32rpx 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.modal-save.disabled { opacity: 0.6; }

/* 注销弹层 */
.deactivate-warn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.deactivate-warn-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--danger);
}
.deactivate-desc {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  background: rgba(220,38,38,0.04);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

/* 双按钮 */
.modal-actions {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx 32rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.modal-btn-cancel {
  background: var(--bg-soft);
  color: var(--text-2);
}
.modal-btn-danger {
  background: linear-gradient(135deg, var(--danger), var(--danger-light));
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(220,38,38,0.25);
}
.modal-btn-danger.disabled { opacity: 0.6; }
