/* about — 关于我们页面 */
.about-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 48rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* 品牌 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  background: rgba(255,255,255,0.1);
}
.brand-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
  margin-top: 16rpx;
}
.brand-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}
.version-tag {
  margin-top: 12rpx;
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.9);
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 核心数据 ========== */
.stats-row {
  display: flex;
  align-items: center;
  background: var(--card);
  margin: -32rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 3;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--primary);
}
.stat-label {
  font-size: 20rpx;
  color: var(--text-2);
}
.stat-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--line);
}

/* ========== 通用卡片 ========== */
.section-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

/* 公司简介 */
.intro-text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 核心优势 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.feature-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.feature-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.feat-icon-1 { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
.feat-icon-2 { background: linear-gradient(135deg, #047857, #10b981); }
.feat-icon-3 { background: linear-gradient(135deg, #b45309, #f59e0b); }
.feat-icon-4 { background: linear-gradient(135deg, #6b21a8, #a78bfa); }
.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.feature-desc {
  font-size: 24rpx;
  color: var(--text-2);
}

/* 资质认证 */
.cert-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cert-item {
  width: calc(50% - 8rpx);
  background: var(--bg-soft);
  border-radius: 14rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cert-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  flex-shrink: 0;
}
.cert-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* 联系我们 */
.contact-list {
  display: flex;
  flex-direction: column;
}
.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--bg-soft);
}
.contact-row:last-child { border-bottom: none; }
.cr-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cr-label {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
}
.cr-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.cr-value {
  font-size: 26rpx;
  color: var(--text-2);
}
.cr-value.addr {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 法律信息 */
.legal-section {
  margin: 20rpx 24rpx 0;
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.legal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid var(--bg-soft);
  font-size: 26rpx;
  color: var(--text-1);
}
.legal-item:last-child { border-bottom: none; }

/* 版权 */
.copyright {
  text-align: center;
  padding: 40rpx 0 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.copyright text {
  font-size: 22rpx;
  color: var(--text-3);
}
.copyright-sub {
  font-size: 20rpx !important;
  color: var(--text-3) !important;
}
.copyright-link {
  margin-top: 4rpx;
}
