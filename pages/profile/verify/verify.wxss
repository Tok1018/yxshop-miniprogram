/* verify — 企业认证页面（蓝色渐变主题） */
.vfy-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 48rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* ========== 认证状态 ========== */
.hero-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 40rpx 0;
  position: relative;
  z-index: 2;
  gap: 12rpx;
}
.hs-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,0.3);
}
.hs-icon-success {
  background: rgba(16,185,129,0.3);
  border-color: rgba(16,185,129,0.5);
}
.hs-icon-pending {
  background: rgba(245,158,11,0.3);
  border-color: rgba(245,158,11,0.5);
}
.hs-icon-reject {
  background: rgba(220,38,38,0.3);
  border-color: rgba(220,38,38,0.5);
}
.hs-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}
.hs-sub {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

/* ========== 通用卡片 ========== */
.section-card {
  background: var(--card);
  margin: 24rpx 24rpx 0 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  overflow: hidden;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

/* ========== 认证权益 ========== */
.benefits-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 12rpx 24rpx 24rpx 24rpx;
}
.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  background: var(--bg-soft);
  border-radius: 16rpx;
}
.bi-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bi-icon-1 { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
.bi-icon-2 { background: linear-gradient(135deg, #10b981, #34d399); }
.bi-icon-3 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.bi-icon-4 { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
.bi-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}
.bi-desc {
  font-size: 20rpx;
  color: var(--text-3);
  text-align: center;
}

/* ========== 拒绝原因 ========== */
.reject-card {
  border-left: 8rpx solid var(--danger);
}
.reject-warn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 8rpx 24rpx;
}
.reject-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--danger);
}
.reject-reason {
  display: block;
  padding: 0 24rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* ========== 信息展示 ========== */
.info-list {
  padding: 0 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line-light);
}
.info-row:last-child {
  border-bottom: none;
}
.ir-label {
  font-size: 26rpx;
  color: var(--text-2);
}
.ir-value {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 500;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 营业执照预览 */
.license-preview {
  padding: 16rpx 24rpx 24rpx;
}
.lp-img {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background: var(--bg-soft);
}

/* ========== 表单 ========== */
.form-list {
  padding: 0 24rpx;
}
.form-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line-light);
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 10rpx;
}
.required { color: var(--danger); }
.form-input {
  font-size: 28rpx;
  color: var(--text-1);
  padding: 12rpx 0;
  background: transparent;
}

/* ========== 上传 ========== */
.upload-list {
  padding: 12rpx 24rpx 24rpx;
  display: flex;
  gap: 24rpx;
}
.upload-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.upload-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
}
.upload-box {
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--bg-soft);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--line);
}
.upload-preview {
  width: 100%;
  height: 100%;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.upload-tip {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ========== 提交按钮 ========== */
.submit-area {
  padding: 32rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.submit-btn.disabled { opacity: 0.6; }
.submit-tip {
  font-size: 22rpx;
  color: var(--text-3);
}
