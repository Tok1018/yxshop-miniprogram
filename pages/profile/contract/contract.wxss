/* contract — 合同管理页面（对齐系统蓝色风格） */
.ct-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 32rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 16rpx 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* ========== 统计 ========== */
.stats-row {
  display: flex;
  padding: 16rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

/* ========== 列表 ========== */
.content-area { padding: 24rpx; }

.contract-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.contract-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.cc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.cc-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cc-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.cc-status-0 { background: rgba(100,116,139,0.1); color: var(--text-2); }
.cc-status-1 { background: rgba(245,158,11,0.1); color: var(--accent); }
.cc-status-2 { background: rgba(16,185,129,0.1); color: var(--success); }
.cc-status-3 { background: rgba(220,38,38,0.1); color: var(--danger); }
.cc-status-4 { background: rgba(100,116,139,0.1); color: var(--text-2); }

.cc-no {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 12rpx;
}

.cc-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--line-light);
}
.cc-row {
  display: flex;
  gap: 12rpx;
}
.cc-label {
  font-size: 24rpx;
  color: var(--text-3);
  width: 80rpx;
  flex-shrink: 0;
}
.cc-value {
  font-size: 24rpx;
  color: var(--text-2);
  flex: 1;
}
.cc-amount { color: var(--primary); font-weight: 700; }

.cc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line-light);
}
.cc-file-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}
.cc-file-tag.no-file { color: #cbd5e1; font-weight: 400; }

/* ========== 详情弹层 ========== */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15,23,42,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.detail-panel {
  width: 100%;
  background: var(--card);
  border-radius: 64rpx 64rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.detail-close {
  font-size: 48rpx;
  color: #cbd5e1;
  padding: 0 8rpx;
  line-height: 1;
  font-weight: 300;
}

.detail-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.detail-name-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.detail-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  flex: 1;
}
.detail-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 10rpx;
}
.detail-status-0 { background: rgba(100,116,139,0.1); color: var(--text-2); }
.detail-status-1 { background: rgba(245,158,11,0.1); color: var(--accent); }
.detail-status-2 { background: rgba(16,185,129,0.1); color: var(--success); }
.detail-status-3 { background: rgba(220,38,38,0.1); color: var(--danger); }
.detail-status-4 { background: rgba(100,116,139,0.1); color: var(--text-2); }

.detail-grid {
  background: var(--bg-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.detail-label {
  font-size: 26rpx;
  color: var(--text-3);
  width: 140rpx;
  flex-shrink: 0;
}
.detail-value {
  font-size: 26rpx;
  color: var(--text-1);
  font-weight: 600;
  flex: 1;
  word-break: break-all;
}
.detail-amount { color: var(--primary); }

.detail-remark {
  margin-top: 24rpx;
  background: #fefce8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.remark-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
  display: block;
  margin-bottom: 8rpx;
}
.remark-content {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.detail-file {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(37,99,235,0.06);
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
}
.detail-file .file-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.detail-actions {
  padding: 16rpx 32rpx 32rpx;
}
.detail-btn-back {
  background: var(--bg-soft);
  color: var(--text-2);
  text-align: center;
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* ========== 加载/空状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  gap: 20rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: var(--text-3); }
.empty-wrap { padding: 100rpx 0; }
