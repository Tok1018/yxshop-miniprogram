/* profile — 企业级个人中心（对照设计稿 profile-mockup.html） */
.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 160rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 140rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco-1 {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.hero-deco-2 {
  position: absolute;
  bottom: 120rpx;
  left: -120rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.nav-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  background: var(--danger);
  border-radius: 50%;
  border: 3rpx solid var(--primary-dark);
}
.nav-spacer {
  width: 72rpx;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border: 6rpx solid rgba(255,255,255,0.3);
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.15);
  flex-shrink: 0;
}
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
}
.user-detail {
  flex: 1;
}
.user-name {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.vip-badge {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(245,158,11,0.3);
}
.vip-badge-text {
  font-size: 20rpx;
  line-height: 1.2;
}
.user-id {
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.copy-id {
  background: rgba(255,255,255,0.15);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.user-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.utag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 数据卡片 */
.stats-card {
  margin: 28rpx 32rpx 0 32rpx;
  background: rgba(255,255,255,0.12);
  border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: 32rpx;
  padding: 28rpx 0;
  display: flex;
  justify-content: space-around;
  position: relative;
  z-index: 2;
}
.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stats-num {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}
.stats-label {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}
.stats-divider {
  width: 2rpx;
  background: rgba(255,255,255,0.15);
}

/* ========== 白色内容区 ========== */
.content-body {
  background: var(--bg);
  border-radius: 48rpx 48rpx 0 0;
  margin-top: -100rpx;
  position: relative;
  z-index: 3;
  padding-top: 0;
}

/* ========== 通用区块卡片 ========== */
.section-card {
  background: var(--card);
  margin: 24rpx 24rpx 0 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
  overflow: hidden;
}

/* ========== 订单快捷入口 ========== */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 12rpx 32rpx;
}
.oh-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.oh-more {
  font-size: 24rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  padding: 16rpx 8rpx 28rpx 8rpx;
}
.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.oi-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.oi-badge {
  position: absolute;
  top: -8rpx;
  right: 4rpx;
  background: var(--danger);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  line-height: 1.3;
  border: 2rpx solid #fff;
}
.oi-text {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}
.oi-icon-1 { background: linear-gradient(145deg, #fef3c7, #fde68a); }
.oi-icon-2 { background: linear-gradient(145deg, #dbeafe, #bfdbfe); }
.oi-icon-3 { background: linear-gradient(145deg, #f0fdfa, #ccfbf1); }
.oi-icon-4 { background: linear-gradient(145deg, #fef2f2, #fee2e2); }
.oi-icon-5 { background: linear-gradient(145deg, #f0f9ff, #e0f2fe); }

/* ========== 钱包卡片 ========== */
.wallet-section {
  padding: 32rpx 0;
}
.wallet-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.wallet-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.wi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wi-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}
.wi-label {
  font-size: 22rpx;
  color: var(--text-2);
}
.wi-icon-1 { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.wi-icon-2 { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
.wi-icon-3 { background: linear-gradient(135deg, #10b981, #34d399); }
.wi-icon-4 { background: linear-gradient(135deg, var(--primary-light), #60a5fa); }

/* ========== 会员升级卡 ========== */
.vip-upgrade {
  margin: 24rpx 24rpx 0 24rpx;
  background: linear-gradient(135deg, #1e293b, #334155);
  border-radius: 32rpx;
  padding: 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.vip-upgrade::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(245,158,11,0.08);
  border-radius: 50%;
}
.vu-left {
  z-index: 2;
}
.vu-title {
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vu-sub {
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}
.vu-btn {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(245,158,11,0.3);
  z-index: 2;
  white-space: nowrap;
}

/* ========== 功能宫格 ========== */
.func-header {
  padding: 28rpx 32rpx 8rpx 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
  padding: 16rpx 0 24rpx 0;
}
.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
}
.fi-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.fi-badge {
  position: absolute;
  top: -6rpx;
  right: -8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  line-height: 1.2;
  border: 2rpx solid #fff;
}
.fi-text {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}
.fi-icon-1 { background: linear-gradient(145deg, #eff6ff, #dbeafe); }
.fi-icon-2 { background: linear-gradient(145deg, #fdf2f8, #fce7f3); }
.fi-icon-3 { background: linear-gradient(145deg, #ecfdf5, #d1fae5); }
.fi-icon-4 { background: linear-gradient(145deg, #fffbeb, #fef3c7); }
.fi-icon-5 { background: linear-gradient(145deg, #f0f9ff, #e0f2fe); }
.fi-icon-6 { background: linear-gradient(145deg, #faf5ff, #f3e8ff); }
.fi-icon-7 { background: linear-gradient(145deg, #fef2f2, #fee2e2); }
.fi-icon-8 { background: linear-gradient(145deg, #f0fdfa, #ccfbf1); }
.fi-icon-9 { background: linear-gradient(145deg, #fffbeb, #fef3c7); }
.fi-icon-10 { background: linear-gradient(145deg, #faf5ff, #f3e8ff); }
.fi-icon-11 { background: linear-gradient(145deg, #f0fdfa, #ccfbf1); }
.fi-icon-12 { background: linear-gradient(145deg, #fdf2f8, #fce7f3); }

/* ========== 营销入口卡 ========== */
.promo-banner {
  margin: 24rpx 24rpx 0 24rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  border-radius: 28rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
  position: relative;
  overflow: hidden;
}
.promo-banner::before {
  content: '';
  position: absolute;
  right: 80rpx;
  top: -60rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.pb-left {
  z-index: 2;
}
.pb-title {
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pb-sub {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}
.pb-icon-wrap {
  z-index: 1;
}
.pb-btn {
  background: rgba(255,255,255,0.2);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255,255,255,0.2);
  z-index: 2;
}

/* ========== 服务列表 ========== */
.service-section {
  overflow: hidden;
}
.svc-item {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  gap: 24rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.svc-item:last-child {
  border-bottom: none;
}
.svc-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.svc-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.svc-desc {
  font-size: 24rpx;
  color: var(--text-3);
}
.svc-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.svc-tag-success {
  background: rgba(16,185,129,0.08);
  color: var(--success);
}
.svc-tag-danger {
  background: rgba(220,38,38,0.08);
  color: var(--danger);
}
.svc-icon-1 { background: linear-gradient(145deg, #eff6ff, #dbeafe); }
.svc-icon-2 { background: linear-gradient(145deg, #ecfdf5, #d1fae5); }
.svc-icon-3 { background: linear-gradient(145deg, #fff7ed, #ffedd5); }
.svc-icon-4 { background: linear-gradient(145deg, #faf5ff, #f3e8ff); }
.svc-icon-5 { background: linear-gradient(145deg, var(--bg-soft), var(--bg-soft)); }
.svc-icon-6 { background: linear-gradient(145deg, #fef3c7, #fde68a); }
.svc-icon-7 { background: linear-gradient(145deg, #faf5ff, #f3e8ff); }

/* ========== 设置列表 ========== */
.settings-section {
  overflow: hidden;
}
.set-item {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  gap: 24rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.set-item:last-child {
  border-bottom: none;
}
.set-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(145deg, var(--bg-soft), var(--bg-soft));
  color: #334155;
}
.set-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
}
.set-val {
  font-size: 24rpx;
  color: var(--text-3);
}

/* ========== 退出按钮 ========== */
.logout-btn {
  margin: 24rpx 24rpx 40rpx 24rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--danger);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

/* ========== 版权信息 ========== */
.profile-copyright {
  text-align: center;
  padding: 20rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.pc-version {
  font-size: 22rpx;
  color: var(--text-3);
}
.pc-link text {
  font-size: 20rpx;
  color: var(--text-3);
}

/* ========== 编辑资料弹层 ========== */
.edit-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15,23,42,0.5);
  z-index: 999;
  backdrop-filter: blur(4px);
}
.edit-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--card);
  border-radius: 64rpx 64rpx 0 0;
  padding: 64rpx;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.edit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}
.edit-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.edit-close {
  font-size: 48rpx;
  color: var(--text-3);
  line-height: 1;
  font-weight: 300;
}
.edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--bg-soft);
}
.edit-label {
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 500;
}
.avatar-btn {
  padding: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  line-height: normal;
}
.avatar-btn::after { border: none; }
.avatar-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}
.nickname-input {
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.edit-save {
  margin-top: 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.3);
}
.edit-save.disabled {
  opacity: 0.6;
}
