/* sign — 每日签到页面 */
.sign-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, #4c1d95 0%, #6b21a8 45%, #8b5cf6 100%);
  padding: 0 0 40rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco-1 {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.hero-deco-2 {
  position: absolute;
  bottom: -120rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
}

/* 导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder {
  width: 64rpx;
}

/* 签到状态卡 */
.sign-card {
  margin: 32rpx 32rpx 0 32rpx;
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.sc-left {
  flex: 1;
}
.sc-label {
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
}
.sc-num {
  color: #fff;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 8rpx;
}
.sc-unit {
  font-size: 28rpx;
  font-weight: 500;
  opacity: 0.8;
}
.sc-sub {
  color: rgba(255,255,255,0.6);
  font-size: 22rpx;
  margin-top: 8rpx;
}
.sc-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.sc-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(245,158,11,0.3);
}
.sc-icon--done {
  background: linear-gradient(135deg, #10b981, #34d399);
  box-shadow: 0 8rpx 20rpx rgba(16,185,129,0.3);
}
.sc-btn {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(245,158,11,0.3);
}
.sc-btn--done {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.6);
  box-shadow: none;
}

/* ========== 日历区 ========== */
.calendar-section {
  margin: 24rpx 24rpx 0 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.cal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}
.cal-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  min-width: 200rpx;
  text-align: center;
}
.cal-weekdays {
  display: flex;
  margin-bottom: 16rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  font-weight: 500;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.cal-day--empty {
  visibility: hidden;
}
.cal-day-num {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}
.cal-day-check {
  position: absolute;
  bottom: 6rpx;
}
.cal-day--signed {
  background: #ecfdf5;
  border-radius: 50%;
}
.cal-day--signed .cal-day-num {
  color: var(--success);
  font-weight: 700;
}
.cal-day--today {
  background: var(--primary-50);
  border-radius: 50%;
  border: 2rpx solid var(--primary);
}
.cal-day--today .cal-day-num {
  color: var(--primary);
  font-weight: 700;
}
.cal-day-today-tag {
  position: absolute;
  bottom: 4rpx;
  font-size: 16rpx;
  color: var(--primary);
  font-weight: 600;
}
.cal-day--future .cal-day-num {
  color: var(--text-3);
}

/* ========== 签到规则 ========== */
.rules-section {
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: var(--shadow-sm);
}
.rules-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.rules-title text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}
.rules-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.rule-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: calc((100% - 96rpx) / 5);
}
.rule-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--line);
}
.rule-circle--done {
  background: linear-gradient(135deg, #10b981, #34d399);
  border-color: transparent;
}
.rule-circle--done .rule-day,
.rule-circle--done .rule-day-unit {
  color: #fff;
}
.rule-day {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  line-height: 1;
}
.rule-day-unit {
  font-size: 18rpx;
  color: var(--text-3);
}
.rule-pts {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 600;
}
.rules-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-light);
}
.rules-tip text {
  font-size: 22rpx;
  color: var(--text-3);
}
