/* integral-log — 积分明细页面 */
.log-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.top-hero {
  background: linear-gradient(160deg, #4c1d95 0%, #6b21a8 45%, #8b5cf6 100%);
  padding: 0 0 40rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco-1 {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder {
  width: 64rpx;
}
.stats-card {
  margin: 32rpx 32rpx 0 32rpx;
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}
.stat-label {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.15);
}

.tab-bar {
  display: flex;
  margin: 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  padding: 6rpx;
  gap: 6rpx;
  box-shadow: var(--shadow-sm);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  border-radius: 12rpx;
  transition: 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}

.log-list {
  padding: 0 24rpx;
}
.log-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
}
.li-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.li-icon--gain {
  background: linear-gradient(135deg, #10b981, #34d399);
}
.li-icon--used {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}
.li-info {
  flex: 1;
  min-width: 0;
}
.li-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  display: block;
}
.li-date {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  display: block;
}
.li-change {
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.li-change--gain {
  color: var(--success);
}
.li-change--used {
  color: var(--accent);
}

.load-more {
  text-align: center;
  padding: 24rpx;
  color: var(--text-3);
  font-size: 24rpx;
}
.empty-wrap {
  padding-top: 120rpx;
}
