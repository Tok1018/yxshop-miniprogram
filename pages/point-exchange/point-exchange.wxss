/* point-exchange — 企业级积分商城（对照设计稿 point-exchange-mockup.html） */
.pe-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 32rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco-1 {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.hero-deco-2 {
  position: absolute;
  bottom: -120rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 50%;
}

/* 导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-rule {
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  padding: 8rpx 0;
}

/* 积分卡片 */
.points-card {
  margin: 24rpx 32rpx 0 32rpx;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 28rpx;
  padding: 40rpx;
  position: relative;
  z-index: 3;
  overflow: hidden;
}
.points-card::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
}
.pc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}
.pc-left { color: #fff; }
.pc-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.pc-num {
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.1;
  margin-top: 8rpx;
}
.pc-unit {
  font-size: 28rpx;
  font-weight: 500;
  opacity: 0.7;
}
.pc-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(245,158,11,0.3);
}
.pc-tips {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
  position: relative;
  z-index: 2;
}
.pc-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ========== 赚积分任务 ========== */
.task-banner {
  margin: 24rpx 24rpx 0 24rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.tb-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.tb-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tb-more {
  font-size: 24rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.task-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.task-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.ti-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ti-icon--blue { background: linear-gradient(135deg, var(--primary), #60a5fa); }
.ti-icon--gold { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.ti-icon--green { background: linear-gradient(135deg, #10b981, #34d399); }
.ti-icon--purple { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
.ti-label {
  font-size: 20rpx;
  color: var(--text-2);
  font-weight: 500;
}
.ti-pts {
  font-size: 18rpx;
  color: #f59e0b;
  font-weight: 600;
}

/* ========== 兑换分类 ========== */
.cate-strip {
  white-space: nowrap;
  padding: 28rpx 24rpx 12rpx 24rpx;
}
.cate-pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: var(--card);
  color: var(--text-2);
  border: 1px solid var(--line-light);
  margin-right: 16rpx;
}
.cate-pill.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.2);
}

/* ========== 兑换商品网格 ========== */
.exchange-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 16rpx 24rpx 20rpx 24rpx;
}
.ex-card {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
  border: 1px solid var(--bg-soft);
}
.img-box {
  width: 100%;
  aspect-ratio: 1/1;
  position: relative;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ex-img {
  width: 100%;
  height: 100%;
}
.img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-soft);
}
.hot-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #dc2626;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.stock-tag {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.ex-info {
  padding: 16rpx 20rpx 20rpx 20rpx;
}
.ex-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  min-height: 72rpx;
}
.ex-points {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 8rpx;
}
.ep-num { font-size: 32rpx; }
.ep-unit { font-size: 20rpx; font-weight: 400; color: var(--text-3); }
.ep-extra { font-size: 20rpx; font-weight: 400; color: var(--text-3); margin-left: 8rpx; }
.ex-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.ex-sold {
  font-size: 20rpx;
  color: var(--text-3);
}
.ex-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  padding: 10rpx 28rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}
.ex-btn--disabled {
  background: var(--bg-soft) !important;
  color: var(--text-3) !important;
  box-shadow: none !important;
}

/* 加载更多 */
.load-more {
  grid-column: span 2;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 24rpx 0;
}

/* 空状态 */
.empty-wrap { padding: 80rpx 0; }

/* ========== 兑换记录 ========== */
.record-banner {
  margin: 16rpx 24rpx 0 24rpx;
  background: linear-gradient(135deg, var(--primary-50), var(--primary-100));
  border-radius: 24rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rb-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.rb-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.2);
}
.rb-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.rb-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.rb-sub {
  font-size: 22rpx;
  color: var(--text-3);
}
