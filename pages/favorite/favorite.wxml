<view class="fav-page">
  <!-- ===== 顶部渐变区 ===== -->
  <view class="top-hero" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hero-deco"></view>
    <view class="top-nav">
      <view class="nav-back" bindtap="onBack">
        <mp-icon name="chevron-right" size="22" color="#fff"></mp-icon>
      </view>
      <text class="nav-title">我的收藏</text>
      <view class="nav-action" wx:if="{{items.length}}" bindtap="onToggleEdit">
        <text>{{editing ? '完成' : '管理'}}</text>
      </view>
      <view wx:else class="nav-placeholder"></view>
    </view>
    <view class="fav-stats" wx:if="{{items.length}}">
      <mp-icon name="heart" size="14" color="rgba(255,255,255,0.7)"></mp-icon>
      <text>已收藏 {{items.length}} 件商品</text>
    </view>
  </view>

  <!-- ===== 收藏列表 ===== -->
  <view class="fav-grid" wx:if="{{items.length}}">
    <view class="fav-card" wx:for="{{items}}" wx:key="key" data-id="{{item.realId}}" bindtap="onItemTap">
      <view class="fav-img-box">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="fav-img" lazy-load></image>
        <view wx:else class="fav-img-placeholder">
          <mp-icon name="package" size="40" color="#cbd5e1"></mp-icon>
        </view>
        <view wx:if="{{editing}}" class="fav-check {{item.checked ? 'fav-check--on' : ''}}" data-id="{{item.realId}}" catchtap="onToggleItem">
          <mp-icon wx:if="{{item.checked}}" name="check" size="14" color="#fff"></mp-icon>
        </view>
        <view wx:if="{{item.is_hot}}" class="fav-tag fav-tag--hot">热卖</view>
      </view>
      <view class="fav-info">
        <view class="fav-name">{{item.name}}</view>
        <view class="fav-price-row">
          <text class="fav-price">¥{{item.price}}</text>
          <text wx:if="{{item.marketPrice}}" class="fav-market">¥{{item.marketPrice}}</text>
        </view>
        <view class="fav-sales">已售 {{item.sales}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{!loading && !items.length}}" class="empty-wrap">
    <empty text="还没有收藏的商品"></empty>
  </view>

  <!-- ===== 底部操作栏（管理模式） ===== -->
  <view wx:if="{{editing && items.length}}" class="bottom-bar">
    <view class="bb-left" bindtap="onSelectAll">
      <view class="bb-check {{allChecked ? 'bb-check--on' : ''}}">
        <mp-icon wx:if="{{allChecked}}" name="check" size="14" color="#fff"></mp-icon>
      </view>
      <text>全选</text>
    </view>
    <view class="bb-remove {{checkedCount > 0 ? '' : 'bb-remove--disabled'}}" bindtap="onRemoveSelected">
      删除{{checkedCount > 0 ? '(' + checkedCount + ')' : ''}}
    </view>
  </view>
</view>
