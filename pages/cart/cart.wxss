/* ============================================================
 * 购物车 — 对照设计稿 cart-mockup.html
 * 设计令牌与 app.wxss 全局变量对齐
 * ============================================================ */

.cart-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 340rpx; /* 结算栏(100rpx) + tabbar(150rpx) + 安全间距 */
}

/* ========== 顶部导航（蓝色渐变） ========== */
.top-bar {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 32rpx 28rpx;
  position: relative;
  overflow: hidden;
}
.top-bar::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}
.nav-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-arrow {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}
.nav-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}
.nav-count {
  font-size: 26rpx;
  opacity: 0.7;
  margin-left: 4rpx;
}
.nav-edit {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
  font-weight: 500;
  min-width: 56rpx;
  text-align: right;
}

/* ========== 选择圆圈 ========== */
.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}
.check-circle.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.check-icon {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

/* ========== 全选管理栏 ========== */
.manage-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--line-light);
}
.mb-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mb-text {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}
.mb-right {
  display: flex;
  gap: 32rpx;
}
.mb-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.mb-btn-text {
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ========== 优惠券提示 ========== */
.coupon-hint {
  background: #fffbeb;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  margin: 16rpx 24rpx 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.coupon-hint-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.coupon-hint-btn {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  padding: 6rpx 20rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* ========== 购物车列表 ========== */
.cart-list {
  padding: 16rpx 24rpx;
}
.cart-group {
  margin-bottom: 16rpx;
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #f1f5f9;
}

/* 店铺头部 */
.store-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line-light);
}
.store-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.store-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.store-coupon {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.store-coupon-text {
  font-size: 22rpx;
  color: var(--accent);
  font-weight: 500;
}

/* 商品条目 */
.cart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--line-light);
  position: relative;
}
.cart-item:last-child {
  border-bottom: none;
}

/* 商品图片 */
.item-img-wrap {
  flex-shrink: 0;
  position: relative;
}
.item-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: var(--bg-soft);
}
.item-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

/* 商品信息 */
.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.35;
}
.item-sku {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.sku-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--bg-soft);
  color: var(--text-2);
  font-weight: 500;
}
.item-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.price-area {
  display: flex;
  align-items: baseline;
}
.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--danger);
}
.item-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger);
}
.item-market-price {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 6rpx;
  text-decoration: line-through;
}

/* 数量控制 */
.qty-control {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--card);
}
.qty-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-2);
  font-weight: 600;
  background: var(--bg-soft);
}
.qty-num {
  width: 64rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  background: var(--card);
  border-left: 2rpx solid var(--line);
  border-right: 2rpx solid var(--line);
}
.qty-btn.plus {
  border-radius: 0 16rpx 16rpx 0;
}

/* ========== 左滑删除 ========== */
.swipe-item {
  position: relative;
  overflow: hidden;
}
.swipe-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  background: var(--danger, #ef4444);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.swipe-action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}
.swipe-content {
  position: relative;
  background: var(--card, #fff);
  z-index: 1;
  will-change: transform;
}

/* ========== 推荐区 ========== */
.recommend-section {
  padding: 32rpx 0 16rpx;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 32rpx 24rpx;
}
.section-line {
  flex: 1;
  max-width: 120rpx;
  height: 2rpx;
  background: var(--line);
}
.section-text-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.section-text {
  font-size: 26rpx;
  color: var(--text-3);
  font-weight: 500;
}
.recommend-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}

/* ========== 底部结算栏 ========== */
.checkout-bar {
  position: fixed;
  bottom: 150rpx; /* 在自定义 tabbar 上方 */
  left: 0;
  right: 0;
  height: 100rpx;
  background: var(--card);
  border-top: 1rpx solid var(--line-light);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
  z-index: 998;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.cb-select {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cb-text {
  font-size: 26rpx;
  color: var(--text-2);
}
.cb-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 2rpx;
}
.cb-label {
  font-size: 24rpx;
  color: var(--text-2);
}
.cb-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--danger);
}
.cb-amount {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--danger);
}
.cb-saving {
  font-size: 22rpx;
  color: var(--success);
  margin-left: 12rpx;
}
.cb-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.25);
}
.cb-btn.disabled {
  background: #cbd5e1;
  box-shadow: none;
}
