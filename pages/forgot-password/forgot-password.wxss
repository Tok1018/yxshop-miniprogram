/* forgot-password — 企业级找回密码页（蓝色渐变风格） */
.fp-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 48rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* 标语 */
.hero-slogan {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.hs-icon {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hs-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 600;
}

/* ========== 步骤指示 ========== */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -24rpx 24rpx 0;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 24rpx 40rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 3;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  color: var(--text-3);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-item.active .step-num {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.25);
}
.step-item text {
  font-size: 22rpx;
  color: var(--text-3);
}
.step-item.active text {
  color: var(--primary);
  font-weight: 600;
}
.step-line {
  width: 80rpx;
  height: 4rpx;
  background: var(--line);
  margin: 0 16rpx;
  margin-bottom: 24rpx;
}
.step-line.active {
  background: var(--primary);
}

/* ========== 表单卡片 ========== */
.form-card {
  margin: 20rpx 24rpx 0;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 0 32rpx;
  box-shadow: var(--shadow-sm);
}
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  min-height: 48rpx;
}
.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.ph {
  color: var(--text-3);
}
.code-row {
  gap: 16rpx;
}
.code-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: var(--primary-50);
  color: var(--primary);
  border-radius: var(--r-sm);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.code-btn.disabled {
  background: var(--bg-soft);
  color: var(--text-3);
}
.form-divider {
  height: 2rpx;
  background: var(--line-light);
}

/* ========== 提交按钮 ========== */
.submit-area {
  padding: 32rpx 24rpx 0;
}
.submit-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-full);
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(37,99,235,0.25);
}
.submit-btn::after {
  border: none;
}
