<view class="fp-page">
  <!-- ===== 顶部渐变区 ===== -->
  <view class="top-hero" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hero-deco"></view>
    <view class="top-nav">
      <view class="nav-back" bindtap="onBack">
        <mp-icon name="chevron-right" size="22" color="#fff"></mp-icon>
      </view>
      <text class="nav-title">找回密码</text>
      <view class="nav-placeholder"></view>
    </view>
    <!-- 标语 -->
    <view class="hero-slogan">
      <view class="hs-icon">
        <mp-icon name="lock" size="20" color="#fff"></mp-icon>
      </view>
      <text class="hs-text">{{step === 1 ? '验证手机号以找回密码' : '设置新的登录密码'}}</text>
    </view>
  </view>

  <!-- ===== 步骤指示 ===== -->
  <view class="step-bar">
    <view class="step-item {{step >= 1 ? 'active' : ''}}">
      <view class="step-num">1</view>
      <text>验证手机</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{step >= 2 ? 'active' : ''}}">
      <view class="step-num">2</view>
      <text>设置密码</text>
    </view>
  </view>

  <!-- ===== 表单卡片 ===== -->
  <view class="form-card">
    <!-- 手机号 -->
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInput"
        disabled="{{step === 2}}"
      />
    </view>
    <view class="form-divider"></view>

    <!-- 验证码（第一步） -->
    <block wx:if="{{step === 1}}">
      <view class="form-row code-row">
        <input
          class="form-input"
          type="number"
          maxlength="6"
          placeholder="请输入验证码"
          placeholder-class="ph"
          value="{{code}}"
          data-field="code"
          bindinput="onInput"
        />
        <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="onSendCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </view>
      </view>
    </block>

    <!-- 新密码（第二步） -->
    <block wx:if="{{step === 2}}">
      <view class="form-row">
        <text class="form-label">新密码</text>
        <input
          class="form-input"
          password
          placeholder="至少6位"
          placeholder-class="ph"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
        />
      </view>
      <view class="form-divider"></view>
      <view class="form-row">
        <text class="form-label">确认密码</text>
        <input
          class="form-input"
          password
          placeholder="再次输入新密码"
          placeholder-class="ph"
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
        />
      </view>
    </block>
  </view>

  <!-- ===== 提交按钮 ===== -->
  <view class="submit-area">
    <button class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">
      {{step === 1 ? '下一步' : '重置密码'}}
    </button>
  </view>

  <view style="height: 60rpx;"></view>
</view>
