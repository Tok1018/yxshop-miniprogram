/* notification — 企业级消息通知页（蓝色渐变风格） */
.notif-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 40rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-action {
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  padding: 8rpx 0;
}
.nav-placeholder { width: 64rpx; }
.hero-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 40rpx 0 40rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  position: relative;
  z-index: 2;
}

/* ========== 消息列表 ========== */
.notif-list {
  padding: 24rpx;
}
.notif-card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}
.notif-card.read {
  opacity: 0.65;
}
.notif-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-light));
}
.notif-card.read::before {
  background: var(--line);
}
.nc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.nc-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.nc-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
  flex-shrink: 0;
}
.nc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nc-title--read {
  font-weight: 500;
  color: var(--text-2);
}
.nc-time {
  font-size: 22rpx;
  color: var(--text-3);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.nc-content {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 加载/空状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
  gap: 20rpx;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: var(--text-3);
}
.empty-wrap {
  padding: 100rpx 0;
}
