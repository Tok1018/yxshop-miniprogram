<view class="notif-page">
  <!-- ===== 顶部渐变区 ===== -->
  <view class="top-hero" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hero-deco"></view>
    <view class="top-nav">
      <view class="nav-back" bindtap="onBack">
        <mp-icon name="chevron-right" size="22" color="#fff"></mp-icon>
      </view>
      <text class="nav-title">消息通知</text>
      <view class="nav-action" wx:if="{{items.length}}" bindtap="onReadAll">
        <text>全部已读</text>
      </view>
      <view wx:else class="nav-placeholder"></view>
    </view>
    <view class="hero-stats" wx:if="{{items.length}}">
      <mp-icon name="bell" size="14" color="rgba(255,255,255,0.7)"></mp-icon>
      <text>共 {{items.length}} 条消息</text>
    </view>
  </view>

  <!-- ===== 消息列表 ===== -->
  <view class="notif-list" wx:if="{{items.length}}">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="notif-card {{item.is_read == 1 ? 'read' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTap"
    >
      <view class="nc-header">
        <view class="nc-title-row">
          <view wx:if="{{item.is_read != 1}}" class="nc-dot"></view>
          <text class="nc-title {{item.is_read == 1 ? 'nc-title--read' : ''}}">{{item.title}}</text>
        </view>
        <text class="nc-time">{{item.prettyDate}}</text>
      </view>
      <view class="nc-content">{{item.content}}</view>
    </view>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{!loading && !items.length}}" class="empty-wrap">
    <empty text="暂无消息通知"></empty>
  </view>

  <view style="height: 60rpx;"></view>
</view>
