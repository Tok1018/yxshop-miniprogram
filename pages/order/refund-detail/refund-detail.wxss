/* order/refund-detail — 企业级退款详情页（蓝色渐变风格） */
.refund-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 48rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-placeholder { width: 64rpx; }

/* 状态区 */
.status-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 40rpx 0;
  position: relative;
  z-index: 2;
}
.status-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 700;
  margin-top: 16rpx;
}
.refund-amount {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

/* ========== 退款进度卡片 ========== */
.timeline-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: -24rpx 24rpx 0;
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 3;
}
.tc-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 28rpx;
}

/* 时间线 */
.timeline {
  padding-left: 8rpx;
}
.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.tl-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}
.tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--line);
  flex-shrink: 0;
  margin-top: 4rpx;
}
.tl-dot--done {
  background: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(37,99,235,0.15);
}
.tl-line {
  width: 2rpx;
  flex: 1;
  min-height: 48rpx;
  background: var(--line);
  margin: 4rpx 0;
}
.tl-content {
  flex: 1;
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.tl-label {
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}
.tl-time {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 空状态 */
.empty-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin: -24rpx 24rpx 0;
  padding: 80rpx 32rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}
