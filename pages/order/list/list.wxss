/* order-list — 企业级订单列表（对照设计稿 order-list-mockup.html） */
.order-page {
  min-height: 100vh;
  background: var(--bg);
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 24rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco-1 {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

/* 导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== Tab 切换 ========== */
.tab-scroll {
  background: var(--card);
  position: sticky;
  top: 0;
  z-index: 5;
  white-space: nowrap;
  border-bottom: 2rpx solid var(--line-light);
}
.tab-bar {
  display: inline-flex;
  padding: 0 8rpx;
}
.tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-2);
  font-weight: 500;
  position: relative;
  white-space: nowrap;
}
.tab-item.active {
  color: var(--primary);
  font-weight: 700;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 6rpx;
}
.tab-badge {
  background: var(--danger);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
  min-width: 28rpx;
  text-align: center;
  margin-left: 6rpx;
}

/* ========== 订单列表 ========== */
.order-list {
  padding: 24rpx;
}
.order-card {
  background: var(--card);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 卡片头部 */
.oc-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid var(--line-light);
}
.oc-store {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.oc-store-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}
.oc-status {
  font-size: 24rpx;
  font-weight: 600;
}
.oc-status-pay { color: var(--danger); }
.oc-status-ship { color: var(--accent); }
.oc-status-recv { color: var(--primary); }
.oc-status-done { color: var(--success); }
.oc-status-refund { color: var(--purple); }
.oc-status-cancel { color: var(--text-3); }

/* 商品列表 */
.oc-items {
  padding: 24rpx 28rpx;
}
.oc-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.oc-item:last-child {
  margin-bottom: 0;
}
.oc-img-wrap {
  flex-shrink: 0;
}
.oc-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 20rpx;
}
.oc-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-soft);
}
.oc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.oc-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}
.oc-sku {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.sku-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--bg-soft);
  color: var(--text-2);
}
.oc-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}
.oc-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}
.oc-qty {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 卡片底部 */
.oc-footer {
  padding: 20rpx 28rpx 24rpx 28rpx;
  border-top: 2rpx solid var(--line-light);
}
.oc-total {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.oc-total-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger);
}
.oc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: wrap;
}
.oc-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  border: 3rpx solid var(--line-light);
  color: var(--text-2);
  background: var(--card);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.oc-btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.2);
}
.oc-btn-danger {
  color: var(--danger);
  border-color: rgba(220,38,38,0.2);
}
.oc-btn-accent {
  color: var(--accent);
  border-color: rgba(245,158,11,0.2);
}

/* ========== 空状态 & 加载 ========== */
.empty-wrap {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}
.loading-tip {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
