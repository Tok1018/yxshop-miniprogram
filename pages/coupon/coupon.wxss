/* coupon — 企业级优惠券页面（对照设计稿 coupon-mockup.html） */
.coupon-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ========== 顶部渐变区 ========== */
.top-hero {
  background: linear-gradient(160deg, var(--primary-dark) 0%, var(--primary) 45%, var(--primary-light) 100%);
  padding: 0 0 32rpx 0;
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}

/* 导航栏 */
.top-nav {
  display: flex;
  align-items: center;
  padding: 8rpx 40rpx 0 40rpx;
  position: relative;
  z-index: 2;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(180deg);
}
.nav-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.nav-rule {
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  padding: 8rpx 0;
}

/* 统计卡片 */
.stats-banner {
  margin: 24rpx 24rpx 0 24rpx;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 28rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 3;
}
.sb-left { color: #fff; }
.sb-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}
.sb-unit {
  font-size: 26rpx;
  font-weight: 400;
}
.sb-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 6rpx;
}
.sb-btn {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(245,158,11,0.3);
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
}

/* ========== Tab 切换 ========== */
.tab-bar {
  display: flex;
  background: var(--card);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 500;
  border-radius: 18rpx;
  transition: 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.2);
}
.tab-count {
  font-size: 20rpx;
  margin-left: 2rpx;
}

/* ========== 优惠券列表 ========== */
.coupon-list {
  padding: 0 24rpx;
}
.coupon-card {
  display: flex;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
}

/* 左侧金额区 */
.cc-left {
  width: 220rpx;
  padding: 36rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  position: relative;
  flex-shrink: 0;
}
.cc-left::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  background: var(--bg);
  border-radius: 50%;
  z-index: 2;
}
.cc-amount {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1;
}
.cc-amount--gift {
  font-size: 36rpx;
}
.cc-sign {
  font-size: 28rpx;
  font-weight: 500;
}
.cc-condition {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 右侧信息区 */
.cc-right {
  flex: 1;
  background: var(--card);
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
}
.cc-right::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  background: var(--bg);
  border-radius: 50%;
  z-index: 2;
}
.cc-info { flex: 1; }
.cc-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.cc-type {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(37,99,235,0.1);
  color: #1e40af;
}
.cc-scope {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.cc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.cc-expire {
  font-size: 20rpx;
  color: var(--text-3);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.cc-btn {
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 36rpx;
  border-radius: 28rpx;
  color: #fff;
}
.cc-btn--disabled {
  background: var(--bg-soft) !important;
  color: var(--text-3) !important;
  box-shadow: none !important;
}

/* 颜色变体 */
.color-blue .cc-left { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
.color-blue .cc-btn { background: linear-gradient(135deg, var(--primary), var(--primary-light)); box-shadow: 0 6rpx 16rpx rgba(37,99,235,0.2); }

.color-red .cc-left { background: linear-gradient(135deg, #dc2626, #f87171); }
.color-red .cc-btn { background: linear-gradient(135deg, #dc2626, #f87171); box-shadow: 0 6rpx 16rpx rgba(220,38,38,0.2); }

.color-gold .cc-left { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.color-gold .cc-btn { background: linear-gradient(135deg, #f59e0b, #fbbf24); box-shadow: 0 6rpx 16rpx rgba(245,158,11,0.2); }

.color-purple .cc-left { background: linear-gradient(135deg, #6b21a8, #8b5cf6); }
.color-purple .cc-btn { background: linear-gradient(135deg, #6b21a8, #8b5cf6); box-shadow: 0 6rpx 16rpx rgba(107,33,168,0.2); }

/* 已使用/已过期 */
.coupon-card.disabled { opacity: 0.5; }
.coupon-card.disabled .cc-left { filter: grayscale(1); }

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 24rpx 0;
}

/* 空状态 */
.empty-wrap {
  padding: 80rpx 0;
}

/* ========== 领券中心 ========== */
.claim-section {
  margin: 16rpx 24rpx 0 24rpx;
}
.claim-header {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ch-title { flex: 1; }
.ch-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(245,158,11,0.1);
  color: #f59e0b;
}
.claim-scroll {
  white-space: nowrap;
  padding-bottom: 12rpx;
}
.claim-card {
  display: inline-flex;
  flex-direction: column;
  width: 260rpx;
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  margin-right: 20rpx;
  vertical-align: top;
}
.claim-card::before {
  content: '';
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}
.claim-amount {
  font-size: 48rpx;
  font-weight: 700;
  position: relative;
  z-index: 2;
}
.claim-sign {
  font-size: 26rpx;
  font-weight: 500;
}
.claim-desc {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
  position: relative;
  z-index: 2;
}
.claim-btn {
  margin-top: 16rpx;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 24rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border: 1px solid rgba(255,255,255,0.2);
  position: relative;
  z-index: 2;
  align-self: flex-start;
}
.claim-btn--disabled {
  opacity: 0.5;
}

/* 领券卡片颜色 */
.cb-blue { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
.cb-red { background: linear-gradient(135deg, #dc2626, #f87171); }
.cb-gold { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.cb-purple { background: linear-gradient(135deg, #6b21a8, #8b5cf6); }
