<view class="edit-page">
  <!-- ===== 顶部渐变区 ===== -->
  <view class="top-hero" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hero-deco"></view>
    <view class="top-nav">
      <view class="nav-back" bindtap="onBack">
        <mp-icon name="chevron-right" size="22" color="#fff"></mp-icon>
      </view>
      <text class="nav-title">{{id ? '编辑地址' : '新增地址'}}</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- ===== 微信导入 ===== -->
  <view class="quick-import" bindtap="onChooseWxAddress">
    <view class="qi-icon">
      <mp-icon name="map-pin" size="18" color="#2563eb"></mp-icon>
    </view>
    <view class="qi-text">
      <text class="qi-title">一键导入微信地址</text>
      <text class="qi-sub">快速填充收货信息</text>
    </view>
    <mp-icon name="chevron-right" size="16" color="#94a3b8"></mp-icon>
  </view>

  <!-- ===== 表单 ===== -->
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入收货人姓名" placeholder-class="ph" data-field="name" bindinput="onInput" value="{{form.name}}" />
    </view>
    <view class="form-divider"></view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入11位手机号" placeholder-class="ph" type="number" maxlength="11" data-field="phone" bindinput="onInput" value="{{form.phone}}" />
    </view>
    <view class="form-divider"></view>
    <picker mode="region" bindchange="onRegionChange" value="{{[form.province, form.city, form.district]}}">
      <view class="form-row">
        <text class="form-label">所在地区</text>
        <view class="form-picker">
          <text wx:if="{{form.province}}" class="picker-text">{{form.province}} {{form.city}} {{form.district}}</text>
          <text wx:else class="ph">请选择省/市/区</text>
        </view>
        <mp-icon name="chevron-right" size="14" color="#cbd5e1"></mp-icon>
      </view>
    </picker>
    <view class="form-divider"></view>
    <view class="form-row form-row--top">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、楼栋、门牌号" placeholder-class="ph" data-field="detail" bindinput="onInput" value="{{form.detail}}" auto-height maxlength="100" />
    </view>
    <view class="form-divider"></view>
    <view class="form-row">
      <text class="form-label">设为默认</text>
      <switch checked="{{form.is_default == 1}}" bindchange="onDefaultChange" color="#2563eb" />
    </view>
  </view>

  <!-- ===== 底部保存按钮 ===== -->
  <view class="bottom-bar">
    <view class="save-btn {{submitting ? 'save-btn--disabled' : ''}}" bindtap="onSubmit">
      <text>{{submitting ? '保存中...' : '保存地址'}}</text>
    </view>
  </view>
</view>
