<view class="point-exchange" wx:if="{{items.length}}">
  <view class="pe-header">
    <view class="pe-title-wrap">
      <mp-icon name="gift" size="16" color="#8b5cf6"></mp-icon>
      <text class="pe-title">积分兑换</text>
    </view>
    <navigator class="pe-more" url="/pages/point-exchange/point-exchange" hover-class="none">
      <text class="pe-more-text">更多</text>
      <text class="pe-more-arrow">›</text>
    </navigator>
  </view>
  <view class="pe-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="pe-card"
      bindtap="onItemTap"
      data-id="{{item.id || item.item_id}}"
    >
      <view class="pe-cover-wrap">
        <image wx:if="{{item.cover || item.image}}" class="pe-cover" src="{{item.cover || item.image}}" mode="aspectFill" lazy-load binderror="onCoverError" data-index="{{index}}"></image>
        <view wx:else class="pe-cover cover-fallback">
          <mp-icon name="package" size="28" color="#94a3b8"></mp-icon>
        </view>
      </view>
      <view class="pe-info">
        <text class="pe-name ellipsis">{{item.name || item.goods_name}}</text>
        <view class="pe-bottom">
          <text class="pe-points">{{item.points || 0}} 积分</text>
          <view class="pe-btn">兑换</view>
        </view>
      </view>
    </view>
  </view>
</view>
