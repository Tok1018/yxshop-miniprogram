/* product-list — 企业级商品列表 */
.product-list {
  margin: 12rpx 24rpx 0;
}

/* 区块标题 */
.pl-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 12rpx;
}
.pl-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pl-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}
.pl-tag {
  background: rgba(37,99,235,0.1);
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.pl-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.pl-more-text {
  font-size: 24rpx;
  color: #94a3b8;
}
.pl-more-arrow {
  font-size: 26rpx;
  color: #94a3b8;
}

/* Grid layout */
.grid-wrap {
  display: grid;
  gap: 16rpx;
}

.product-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f1f5f9;
}
.cover-wrap {
  width: 100%;
  position: relative;
}
.cover {
  width: 100%;
  height: 340rpx;
  background: #f1f5f9;
}

/* 商品图片占位（无图或加载失败时） */
.cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}
.cover-fallback-text {
  font-size: 22rpx;
  color: #94a3b8;
}
.item-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx 0 20rpx 0;
}
.info {
  padding: 14rpx 18rpx 14rpx;
}
.title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
  min-height: 72rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}
.mini-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.mini-tag.tag-success { background: #ecfdf5; color: #047857; }
.mini-tag.tag-primary { background: #eff6ff; color: #1e40af; }
.mini-tag.tag-default { background: #f1f5f9; color: #64748b; }
.bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 8rpx;
}
.price-area {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-wrap: wrap;
}
.origin-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}
.cart-btn {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(37,99,235,0.25);
  flex-shrink: 0;
}
.symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #dc2626;
}
.price {
  font-size: 30rpx;
  font-weight: 700;
  color: #dc2626;
}
.sold {
  font-size: 22rpx;
  color: #94a3b8;
}

/* Loading skeleton */
.pl-skeleton-row {
  display: grid;
  gap: 16rpx;
}
.pl-skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}
.pl-skeleton-img {
  width: 100%;
  height: 340rpx;
  background: #e2e8f0;
}
.pl-skeleton-line {
  height: 24rpx;
  margin: 14rpx 18rpx 0;
  background: #e2e8f0;
  border-radius: 6rpx;
}
.skeleton-anim {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}
@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 状态 */
.load-error {
  text-align: center;
  padding: 48rpx;
  background: #fff;
  border-radius: 20rpx;
}
.load-error-text {
  font-size: 26rpx;
  color: #94a3b8;
}
.pl-empty {
  text-align: center;
  padding: 48rpx;
  background: #fff;
  border-radius: 20rpx;
}
.pl-empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}
