/* search-bar — 企业级搜索框 */
.search-bar {
  background: #fff;
  padding: 12rpx 24rpx 14rpx;
  display: flex;
  align-items: center;
}

/* 城市定位按钮 */
.city-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  max-width: 180rpx;
}
.city-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 120rpx;
}

/* Hero 模式：透明背景，搜索框半透明白色 */
.search-bar.hero {
  background: transparent;
  padding: 10rpx 24rpx 6rpx;
}
.search-bar.hero .search-box {
  background: rgba(255,255,255,0.95);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.search-bar.hero .msg-red-dot {
  border-color: rgba(30,58,138,0.5);
}
.search-bar.hero .city-name {
  color: #fff;
}

.search-box {
  background: #f1f5f9;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx 0 24rpx;
  gap: 12rpx;
  color: #94a3b8;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  flex: 1;
}
.search-box.rounded {
  border-radius: 36rpx;
}
.search-box.square {
  border-radius: 12rpx;
}
.placeholder {
  flex: 1;
  font-size: 26rpx;
  color: #94a3b8;
}
.scan-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.msg-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  position: relative;
}
.msg-red-dot {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 14rpx;
  height: 14rpx;
  background: #dc2626;
  border-radius: 50%;
  border: 2rpx solid #fff;
}
