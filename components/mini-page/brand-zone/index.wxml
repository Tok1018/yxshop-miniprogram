<view class="brand-zone" wx:if="{{items.length}}">
  <view class="bz-header">
    <view class="bz-title-wrap">
      <mp-icon name="trophy" size="16" color="#0f172a"></mp-icon>
      <text class="bz-title">{{title}}</text>
    </view>
    <view class="bz-more" wx:if="{{moreText}}" bindtap="onMoreTap">
      <text>{{moreText}}</text>
      <text class="bz-arrow">›</text>
    </view>
  </view>
  <view class="bz-grid" style="grid-template-columns: repeat({{columns}}, 1fr);">
    <view
      wx:for="{{items}}"
      wx:key="index"
      class="bz-item"
      bindtap="onItemTap"
      data-index="{{index}}"
    >
      <image wx:if="{{item.logo}}" class="bz-logo" src="{{item.logo}}" mode="aspectFit" lazy-load></image>
      <text wx:else class="bz-name">{{item.name}}</text>
    </view>
  </view>
</view>
