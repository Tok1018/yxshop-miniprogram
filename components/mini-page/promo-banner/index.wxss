.promo-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 24rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
}

.promo-banner.style-solid {
  background: linear-gradient(135deg, var(--bg1, #2563eb), var(--bg2, #3b82f6));
  color: #fff;
}

.promo-banner.style-dark {
  background: linear-gradient(135deg, var(--bg1, #1e293b), var(--bg2, #334155));
  color: #fff;
}

.promo-banner.style-glass {
  background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
  border: 1rpx solid rgba(255,255,255,0.15);
  color: #fff;
}

.pb-glass-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: inherit;
  filter: blur(16rpx);
  z-index: 0;
}

.promo-banner.style-glass .pb-icon-wrap,
.promo-banner.style-glass .pb-content,
.promo-banner.style-glass .pb-btn {
  position: relative;
  z-index: 1;
}

.pb-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f59e0b, #f97316);
}

.pb-icon {
  font-size: 36rpx;
  color: #fff;
}

.pb-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.pb-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pb-subtitle {
  font-size: 22rpx;
  opacity: 0.8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pb-btn {
  flex-shrink: 0;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.2);
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.promo-banner.style-glass .pb-btn {
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border: none;
}

.pb-pulse {
  width: 20rpx;
  height: 20rpx;
  background: #dc2626;
  border-radius: 50%;
  flex-shrink: 0;
  animation: pb-pulse-anim 1.5s ease infinite;
}

@keyframes pb-pulse-anim {
  0% { box-shadow: 0 0 0 0 rgba(220,38,38,0.5); }
  70% { box-shadow: 0 0 0 16rpx rgba(220,38,38,0); }
  100% { box-shadow: 0 0 0 0 rgba(220,38,38,0); }
}
