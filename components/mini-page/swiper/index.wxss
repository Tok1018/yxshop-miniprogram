/* swiper — 企业级轮播 */
.mp-swiper-wrap {
  margin: 12rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(37,99,235,0.08);
}
.mp-swiper {
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.swiper-img {
  width: 100%;
  height: 100%;
}

/* 占位 Banner */
.swiper-placeholder {
  height: 320rpx;
  background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  position: relative;
  overflow: hidden;
}
.placeholder-inner {
  display: flex;
  flex-direction: column;
  z-index: 2;
}
.placeholder-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.5rpx;
}
.placeholder-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 12rpx;
}
.placeholder-tag {
  margin-top: 20rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(4px);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
  width: fit-content;
}
.tag-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.placeholder-deco {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 50%;
}
