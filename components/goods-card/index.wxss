/* goods-card — 企业级商品卡片 */
.goods-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f1f5f9;
  transition: all 0.15s;
}

/* ===== Grid 布局 ===== */
.goods-card.grid { padding-bottom: 14rpx; }
.goods-card.grid .cover-wrap {
  width: 100%;
  position: relative;
}
.goods-card.grid .cover {
  width: 100%;
  height: 340rpx;
  background: #f1f5f9;
}
.goods-card.grid .cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
}
.goods-card.grid .cover-fallback-text {
  font-size: 22rpx;
  color: #94a3b8;
}
.goods-card.grid .cover-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}
.goods-card.grid .cover-badge.badge-hot { background: linear-gradient(135deg, #dc2626, #ef4444); }
.goods-card.grid .cover-badge.badge-new { background: linear-gradient(135deg, #2563eb, #3b82f6); }
.goods-card.grid .cover-badge.badge-sale { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.goods-card.grid .cover-badge.badge-green { background: linear-gradient(135deg, #10b981, #34d399); }

.goods-card.grid .info { padding: 14rpx 18rpx 0 18rpx; }
.goods-card.grid .title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
  min-height: 72rpx;
}
.goods-card.grid .desc {
  color: #64748b;
  margin-top: 6rpx;
}
.goods-card.grid .tags {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0;
}
.goods-card.grid .mini-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.goods-card.grid .mini-tag.tag-success { background: #ecfdf5; color: #047857; }
.goods-card.grid .mini-tag.tag-primary { background: #eff6ff; color: #1e40af; }
.goods-card.grid .bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}
.goods-card.grid .price-area {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}
.goods-card.grid .symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #dc2626;
}
.goods-card.grid .price {
  font-size: 30rpx;
  font-weight: 700;
  color: #dc2626;
}
.goods-card.grid .market-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
  margin-left: 6rpx;
}
.goods-card.grid .sold {
  font-size: 22rpx;
  color: #94a3b8;
}
.goods-card.grid .cart-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.25);
  flex-shrink: 0;
}
.goods-card.grid .cart-plus {
  color: #fff;
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
}
.goods-card.grid .sold-line {
  font-size: 20rpx;
  color: #94a3b8;
  padding: 0 18rpx 4rpx 18rpx;
}

/* ===== List 布局 ===== */
.goods-card.list {
  display: flex;
  padding: 20rpx;
}
.goods-card.list .cover-wrap {
