.empty {
  padding: 120rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.empty-emoji {
  font-size: 72rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}
.empty-sub {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}
.empty-btn {
  margin-top: 32rpx;
  padding: 16rpx 56rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.25);
}
