<view wx:if="{{visible}}" class="sku-mask" catchtap="onClose">
  <view class="sku-panel safe-area-bottom" catchtap="noop">
    <view class="sku-header">
      <image class="sku-cover" src="{{currentImage}}" mode="aspectFill"></image>
      <view class="sku-info">
        <view class="sku-price">¥ {{currentPrice}}</view>
        <view class="sku-stock">库存 {{currentStock}}</view>
      </view>
      <view class="sku-close" catchtap="onClose">×</view>
    </view>

    <scroll-view scroll-y class="sku-body">
      <block wx:for="{{specDimensions}}" wx:key="name" wx:for-item="dim">
        <view class="spec-row">
          <view class="spec-label">{{dim.name}}</view>
          <view class="spec-values">
            <view
              wx:for="{{dim.values || []}}"
              wx:for-item="val"
              wx:key="label"
              class="spec-btn {{selectedMap[dim.name] === val.label ? 'spec-btn--active' : ''}} {{!val.available ? 'spec-btn--disabled' : ''}}"
              data-name="{{dim.name}}"
              data-value="{{val.label}}"
              bindtap="onSpecTap"
            >{{val.label}}</view>
          </view>
        </view>
      </block>

      <view class="qty-row">
        <view class="qty-label">数量</view>
        <view class="qty">
          <view class="qty-btn" data-delta="-1" bindtap="onChangeQty">−</view>
          <view class="qty-num">{{quantity}}</view>
          <view class="qty-btn" data-delta="1" bindtap="onChangeQty">＋</view>
        </view>
      </view>
    </scroll-view>

    <button class="sku-confirm {{!specComplete && specDimensions.length > 0 ? 'sku-confirm--disabled' : ''}}" bindtap="onConfirm">
      {{action === 'buy' ? '立即购买' : '加入购物车'}}
    </button>
  </view>
</view>