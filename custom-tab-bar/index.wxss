/* ============================================================
 * 自定义底部导航 — 对照设计稿 item-detail-mockup / home-mockup
 * 矢量图标 · 购物车凸起 · 激活态阴影
 * 设计稿高度: 56px(112rpx) + 购物车凸起 8px(16rpx) = 总视觉 128rpx
 * ============================================================ */

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 150rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  z-index: 9999;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* ========== 单个 tab 项 ========== */
.tabbar-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  padding-bottom: 8rpx;
  position: relative;
  transition: 0.15s;
}

.tabbar-item-hover {
  opacity: 0.65;
}

/* ========== 普通图标容器 ========== */
.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.2s ease;
}

.tabbar-item.active .tabbar-icon {
  transform: scale(1.1);
  filter: drop-shadow(0 4rpx 12rpx rgba(37, 99, 235, 0.2));
}

/* ========== 购物车凸起样式 ========== */
.tabbar-cart {
  position: relative;
}

.cart-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -32rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
  position: relative;
  transition: transform 0.2s ease;
  border: 4rpx solid #fff;
}

.tabbar-item.active .cart-icon-wrap {
  transform: scale(1.05);
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.4);
}

/* ========== 角标（购物车数量等） ========== */
.tabbar-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  background: #dc2626;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  text-align: center;
  line-height: 1.4;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(220, 38, 38, 0.3);
  z-index: 2;
}

/* 购物车角标定位在凸起圆右上角 */
.tabbar-cart .tabbar-badge {
  top: -6rpx;
  right: -6rpx;
}

/* ========== 文字 ========== */
.tabbar-text {
  font-size: 20rpx;
  font-weight: 500;
  transition: color 0.15s;
  line-height: 1.2;
}

.tabbar-item.active .tabbar-text {
  font-weight: 600;
}

/* 购物车文字略上移 */
.tabbar-cart .tabbar-text {
  margin-top: 0;
}

/* ========== 自定义图标（后台配置图片URL时） ========== */
.tab-custom-icon {
  width: 44rpx;
  height: 44rpx;
}
.cart-custom-icon {
  width: 44rpx;
  height: 44rpx;
  color: #fff;
}
