<view class="tabbar" style="background: {{backgroundColor}};">
  <view
    wx:for="{{list || []}}"
    wx:key="key"
    class="tabbar-item {{selected === index ? 'active' : ''}} {{item.isCart ? 'tabbar-cart' : ''}}"
    data-index="{{index}}"
    bindtap="onItemTap"
    hover-class="tabbar-item-hover"
  >
    <!-- 购物车特殊样式：凸起渐变圆 -->
    <view wx:if="{{item.isCart}}" class="cart-icon-wrap">
      <image wx:if="{{item.useCustomIcon}}" src="{{selected === index ? item.iconActive : item.icon}}" class="cart-custom-icon" mode="aspectFit"></image>
      <mp-icon wx:else name="{{selected === index ? item.iconActive : item.icon}}" size="20" color="#fff"></mp-icon>
      <view wx:if="{{item.badge > 0}}" class="tabbar-badge">{{item.badge > 99 ? '99+' : item.badge}}</view>
    </view>
    <!-- 普通图标 -->
    <view wx:else class="tabbar-icon">
      <image wx:if="{{item.useCustomIcon}}" src="{{selected === index ? item.iconActive : item.icon}}" class="tab-custom-icon" mode="aspectFit"></image>
      <mp-icon wx:else name="{{selected === index ? item.iconActive : item.icon}}" size="22" color="{{selected === index ? selectedColor : color}}"></mp-icon>
      <view wx:if="{{item.badge > 0}}" class="tabbar-badge">{{item.badge > 99 ? '99+' : item.badge}}</view>
    </view>
    <text class="tabbar-text" style="color: {{selected === index ? selectedColor : color}};">{{item.text}}</text>
  </view>
</view>
