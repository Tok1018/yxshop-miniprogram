/**
 * yxshop-miniprogram global stylesheet
 * 企业级电商统一设计系统 — 蓝色主题
 */

page {
  /* 主题色系 */
  --primary: #2563eb;
  --primary-dark: #1e3a8a;
  --primary-light: #3b82f6;
  --primary-50: #eff6ff;
  --primary-100: #dbeafe;

  --accent: #f59e0b;
  --accent-light: #fbbf24;

  --danger: #dc2626;
  --danger-light: #ef4444;
  --success: #10b981;
  --success-light: #34d399;
  --purple: #8b5cf6;

  /* 文字色阶 */
  --text-1: #0f172a;
  --text-2: #475569;
  --text-3: #94a3b8;

  /* 背景与边框 */
  --bg: #f5f7fa;
  --bg-soft: #f1f5f9;
  --card: #ffffff;
  --line: #e2e8f0;
  --line-light: #f0f2f5;

  /* 价格色 */
  --price: #dc2626;

  /* 圆角 */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-xl: 32rpx;
  --r-full: 999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.08);

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-tap-highlight-color: transparent;
}

view, text, image, button, input, navigator, scroll-view {
  box-sizing: border-box;
}

button {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1.5;
  font-size: 28rpx;
}
button::after { border: none; }

/* ========== 布局原子类 ========== */
.flex { display: flex; }
.flex-1 { flex: 1; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }

/* ========== 间距原子类 ========== */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-40 { margin-top: 40rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.ml-24 { margin-left: 24rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }
.px-24 { padding-left: 24rpx; padding-right: 24rpx; }
.px-32 { padding-left: 32rpx; padding-right: 32rpx; }
.py-16 { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-24 { padding-top: 24rpx; padding-bottom: 24rpx; }

/* ========== 文字原子类 ========== */
.text-1 { color: var(--text-1); }
.text-2 { color: var(--text-2); }
.text-3 { color: var(--text-3); }
.text-primary { color: var(--primary); }
.text-danger { color: var(--danger); }
.text-success { color: var(--success); }
.text-accent { color: var(--accent); }
.text-price { color: var(--price); font-weight: 700; }
.text-white { color: #ffffff; }

.bold { font-weight: 600; }
.bold-700 { font-weight: 700; }

.fz-20 { font-size: 20rpx; }
.fz-22 { font-size: 22rpx; }
.fz-24 { font-size: 24rpx; }
.fz-26 { font-size: 26rpx; }
.fz-28 { font-size: 28rpx; }
.fz-30 { font-size: 30rpx; }
.fz-32 { font-size: 32rpx; }
.fz-34 { font-size: 34rpx; }
.fz-36 { font-size: 36rpx; }
.fz-40 { font-size: 40rpx; }
.fz-44 { font-size: 44rpx; }
.fz-48 { font-size: 48rpx; }

/* ========== 文字截断 ========== */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ellipsis-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ========== 卡片 ========== */
.card {
  background: var(--card);
  border-radius: var(--r-md);
  overflow: hidden;
}
.card-shadow {
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-sm);
}

/* ========== 按钮 ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: var(--r-full);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.25);
}
.btn-danger {
  background: linear-gradient(135deg, var(--danger), var(--danger-light));
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(220,38,38,0.2);
}
.btn-outline {
  background: #fff;
  color: var(--text-1);
  border: 2rpx solid var(--line);
}
.btn-ghost {
  background: var(--primary-50);
  color: var(--primary);
}
.btn-block { display: flex; width: 100%; }
.btn-sm { height: 56rpx; padding: 0 24rpx; font-size: 24rpx; }
.btn-lg { height: 88rpx; padding: 0 48rpx; font-size: 32rpx; }

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: var(--primary-50);
  color: var(--primary);
}
.tag-danger { background: #fef2f2; color: var(--danger); }
.tag-success { background: #ecfdf5; color: var(--success); }
.tag-accent { background: #fffbeb; color: var(--accent); }
.tag-purple { background: #f5f3ff; color: var(--purple); }

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 0 24rpx;
}
.divider-thick {
  height: 8rpx;
  background: var(--bg-soft);
  margin: 0;
}

/* ========== 渐变背景工具 ========== */
.bg-primary-gradient {
  background: linear-gradient(135deg, var(--primary-dark), var(--primary));
}
.bg-card-gradient {
  background: linear-gradient(135deg, var(--primary-50), var(--primary-100));
}

/* ========== 安全区 ========== */
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }
.safe-area-top { padding-top: env(safe-area-inset-top); }

/* ========== 动画 ========== */
.fade-in {
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
